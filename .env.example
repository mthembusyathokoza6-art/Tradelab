# Server-side only. Put fresh values in local .env/Netlify environment variables.
# Never put these values in public/, admin-site/, SQL output, chat, or browser storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SESSION_PEPPER=

# Public/admin origin allowlist. Use both production origins and local Netlify Dev origins.
APP_ORIGIN=http://localhost:8888
ADMIN_ORIGIN=
TRUSTED_ORIGINS=

# Provider credentials (server-side only). Use newly rotated keys; never reuse exposed draft values.
TWELVEDATA_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Email adapter: a server-to-server JSON endpoint receiving {from,to,subject,text,html}.
# Optional verification emails are sent if configured; required only when the flag below is true.
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=

# Current product decision: allow signup/sign-in before email verification. Email verification
# must be enforced before any future payout; payout processing is not implemented yet.
EMAIL_VERIFICATION_REQUIRED=false

# Registration remains gated until owner/legal review and publication of the final policy versions.
LEGAL_TERMS_VERSION=
LEGAL_RISK_VERSION=
LEGAL_PRIVACY_VERSION=

# Safety switches — remain false until both additive migrations are reviewed/applied, the approved
# catalogue values are aligned, provider/legal terms are ready, and signed settlement tests pass.
# The application refuses checkout by default; toggling these alone does not make it production-ready.
NOWPAYMENTS_WEBHOOK_ENABLED=false
CHECKOUT_ENABLED=false
